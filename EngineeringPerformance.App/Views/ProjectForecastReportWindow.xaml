<Window x:Class="EngineeringPerformance.App.Views.ProjectForecastReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        mc:Ignorable="d"
        Title="Прогноз трудозатрат"
        Height="800" Width="1200"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo.png">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#2C3E50" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- Шаблон строки-карточки направления ИИС -->
        <DataTemplate x:Key="ForecastRowTemplate">
            <Border Background="#FFFFFF"
                    CornerRadius="6"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="14,10">
                <Border.Margin>
                    <MultiBinding StringFormat="{}{0},0,0,6">
                        <Binding Path="IndentMargin" />
                    </MultiBinding>
                </Border.Margin>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <!-- Название -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,12,0" />

                    <!-- Ед. изм. -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding UnitName, TargetNullValue=—}"
                               FontSize="12" Foreground="#64748B"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <!-- Норм. производит. -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding NormProductivity, StringFormat={}{0:N4}, TargetNullValue=—}"
                               FontSize="12" Foreground="#64748B"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Margin="0,0,8,0" />

                    <!-- Базовый -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <TextBlock Text="{Binding BaseHours, StringFormat={}{0:N1}, TargetNullValue=—}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50"
                                   HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Оптимист. -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <TextBlock Text="{Binding OptimisticHours, StringFormat={}{0:N1}, TargetNullValue=—}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#27AE60"
                                   HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Пессимист. -->
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <TextBlock Text="{Binding PessimisticHours, StringFormat={}{0:N1}, TargetNullValue=—}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#E74C3C"
                                   HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Диапазон -->
                    <Border Grid.Column="6"
                            Background="#F8FAFC" CornerRadius="3" Padding="6,2"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Range, TargetNullValue=—}"
                                   FontSize="11" Foreground="#64748B" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" Padding="20,14"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Прогноз трудозатрат"
                               FontSize="18" FontWeight="Bold" Foreground="#2C3E50" />
                    <TextBlock Text="{Binding ProjectNameWithVersion}"
                               FontSize="16" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Excel" Command="{Binding ExportToExcelCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#27AE60" Margin="0,0,8,0"
                            ToolTip="Экспортировать прогноз в Excel (.xlsx)" />
                    <Button Content="Обновить" Command="{Binding RefreshCommand}"
                            Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="Закрыть" Command="{Binding CloseCommand}"
                            Style="{StaticResource ActionButtonStyle}" Background="#94A3B8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- Loading -->
                <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                        Background="#FFFFFF" CornerRadius="6" Padding="20" Margin="0,0,0,12"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <TextBlock Text="Загрузка прогноза..." FontSize="14"
                               Foreground="#7F8C8D" HorizontalAlignment="Center" />
                </Border>

                <!-- Error -->
                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                        Background="#FDEDEC" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                        BorderBrush="#E74C3C" BorderThickness="1">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B"
                               FontSize="13" TextWrapping="Wrap" />
                </Border>

                <!-- Заголовок колонок -->
                <Border Background="#2C3E50" CornerRadius="6" Padding="14,8" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Наименование" Foreground="#94A3B8"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Ед. изм." Foreground="#94A3B8"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Норм. произв." Foreground="#94A3B8"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="3" Text="Базовый, ч" Foreground="#94A3B8"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" Text="Оптимист., ч" Foreground="#27AE60"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="5" Text="Пессимист., ч" Foreground="#E74C3C"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="6" Text="Диапазон" Foreground="#94A3B8"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Итого по проекту -->
                <Border Background="#1E3A5F" CornerRadius="6" Padding="14,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ИТОГО по проекту"
                                   Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="—" Foreground="#64748B"
                                   FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="—" Foreground="#64748B"
                                   FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding TotalBaseHours, StringFormat={}{0:N1}}"
                                   Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4"
                                   Text="{Binding TotalOptimisticHours, StringFormat={}{0:N1}}"
                                   Foreground="#A9DFBF" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="5"
                                   Text="{Binding TotalPessimisticHours, StringFormat={}{0:N1}}"
                                   Foreground="#F1948A" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="6" Text="—" Foreground="#64748B"
                                   FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Строки прогноза -->
                <ItemsControl ItemsSource="{Binding Rows}"
                              ItemTemplate="{StaticResource ForecastRowTemplate}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
