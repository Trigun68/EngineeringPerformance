<Window x:Class="EngineeringPerformance.App.Views.DataImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="{Binding WindowTitle}"
        Height="300" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="{Binding WindowTitle}" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Data Type Label -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип данных" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DataTypeDisplayText}" FontWeight="SemiBold" VerticalAlignment="Center" />

                <!-- File Path -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Файл" VerticalAlignment="Center" />
                <dxe:TextEdit Grid.Row="2" Grid.Column="1" EditValue="{Binding SelectedFilePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" NullText="Выберите файл..." />
                <Button Grid.Row="2" Grid.Column="2" Content="Обзор..." Command="{Binding BrowseFileCommand}" Width="80" Margin="8,0,0,0" />

                <!-- Description -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Описание" VerticalAlignment="Center" />
                <dxe:TextEdit Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" EditValue="{Binding Description, UpdateSourceTrigger=PropertyChanged}" NullText="Необязательно" />

                <!-- Error Message -->
                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />

                <!-- Buttons -->
                <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Импорт" Command="{Binding ImportCommand}" Width="100" Margin="0,0,8,0" IsDefault="True" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
