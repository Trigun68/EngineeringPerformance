<Window x:Class="EngineeringPerformance.App.Views.ProjectParticipantEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="{Binding WindowTitle}"
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="{Binding WindowTitle}" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search Filter -->
                <TextBlock Grid.Row="0" Text="Поиск по имени" Margin="0,0,0,4" />
                <dxe:TextEdit Grid.Row="1"
                              EditValue="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                              NullText="Введите имя для поиска..."
                              Margin="0,0,0,8" />

                <!-- Error Message (Auto height — не забирать всю звёздочную высоту у грида) -->
                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,4" />

                <!-- User List (остаток окна — конечная высота для DevExpress GridControl) -->
                <dxg:GridControl Grid.Row="3" ItemsSource="{Binding FilteredParticipants}"
                                 SelectedItem="{Binding SelectedParticipant, UpdateSourceTrigger=PropertyChanged}"
                                 AutoGenerateColumns="None"
                                 Margin="0,0,0,8"
                                 VerticalAlignment="Stretch">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="DisplayName" Header="Имя" Width="*" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowEditing="False" NavigationStyle="Row" ShowGroupPanel="False"
                                       AutoWidth="True" />
                    </dxg:GridControl.View>
                </dxg:GridControl>

                <!-- Buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Margin="0,0,8,0" IsDefault="True" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
