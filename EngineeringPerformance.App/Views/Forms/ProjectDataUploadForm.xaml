<UserControl x:Class="EngineeringPerformance.App.Views.Forms.ProjectDataUploadForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Загрузка данных по проекту" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="Выберите или создайте новую версию анализа проекта" Margin="0,0,0,8" />
            <dxe:ComboBoxEdit NullText="Выберите версию..." Width="400" HorizontalAlignment="Left" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <TextBlock Text="Область загрузки данных" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="#999" FontSize="14" />
        </Border>
    </Grid>
</UserControl>
