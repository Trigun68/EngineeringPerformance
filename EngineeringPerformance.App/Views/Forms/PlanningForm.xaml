<UserControl x:Class="EngineeringPerformance.App.Views.Forms.PlanningForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:converters="clr-namespace:EngineeringPerformance.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="1400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionHeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#2C3E50" />
            <Setter Property="Padding" Value="16,10" />
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECF0F1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionContentBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7F8C8D" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2C3E50" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource InfoValueStyle}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#27AE60" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#219A52" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#A9DFBF" />
                    <Setter Property="Foreground" Value="#F5F5F5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScenarioBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:DispatcherService />
    </dxmvvm:Interaction.Behaviors>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar: проект и версия — только в блоке «Характеристики проекта» ниже -->
        <Border Grid.Row="0" Background="#FFFFFF" Padding="16,12" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Выбрать проект"
                        Command="{Binding SelectProjectCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="Сохранить"
                        Command="{Binding SavePlannedVolumesCommand}"
                        Style="{StaticResource SaveButtonStyle}"
                        ToolTip="Сохранить изменённые плановые объёмы в базу и пересчитать прогноз"
                        Margin="0,0,8,0" />
                <Button Content="Обновить"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,8,0" />
            </StackPanel>
        </Border>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>

                <!-- Loading Indicator -->
                <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                        Background="#FFFFFF" CornerRadius="6" Padding="24" Margin="0,0,0,16"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Загрузка данных..." FontSize="14" Foreground="#7F8C8D" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Error Message -->
                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                        Background="#FDEDEC" CornerRadius="6" Padding="16" Margin="0,0,0,16"
                        BorderBrush="#E74C3C" BorderThickness="1">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" FontSize="14" TextWrapping="Wrap" />
                </Border>

                <!-- Section 1: Project Characteristics -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SectionHeaderBorderStyle}"
                                ToolTip="Блок характеристик проекта; сверка с листом «Прогноз» в PEPM_metric (вкладка Прогноз).">
                            <TextBlock Text="Характеристики проекта" Style="{StaticResource SectionHeaderTextStyle}" />
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SectionContentBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Название проекта:" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Report.ProjectName, Mode=OneWay}" Style="{StaticResource InfoValueStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Код / версия:" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource InfoValueStyle}">
                                        <Run Text="{Binding Report.ProjectCode, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Report.VersionName, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="Дополнительно" Style="{StaticResource InfoLabelStyle}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding ProjectCharacteristics, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Key}" Style="{StaticResource InfoLabelStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource InfoValueStyle}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Section 2: Planned Volumes Input -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SectionHeaderBorderStyle}"
                                ToolTip="Плановые объёмы по группам ИИС (редактирование в колонке «Плановый объём» на любом уровне дерева). Сохранение в БД — кнопка «Сохранить» вверху формы.">
                            <TextBlock Text="Ввод планируемых объёмов работ" Style="{StaticResource SectionHeaderTextStyle}" />
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SectionContentBorderStyle}">
                            <dxg:GridControl ItemsSource="{Binding PlannedVolumes}"
                                             AutoGenerateColumns="None"
                                             MaxHeight="350">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="Name"
                                                    Header="Группа физ. объёмов (ИИС)"
                                                    Width="280"
                                                    AllowEditing="False" />
                                    <dxg:GridColumn FieldName="UnitName"
                                                    Header="Ед. изм."
                                                    Width="90"
                                                    AllowEditing="False" />
                                    <dxg:GridColumn FieldName="NormProductivity"
                                                    Header="Производительность"
                                                    Width="130"
                                                    AllowEditing="False"
                                                    HorizontalHeaderContentAlignment="Right">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N4"
                                                                  HorizontalContentAlignment="Right" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="PlannedVolume"
                                                    Header="Плановый объём"
                                                    Width="140"
                                                    AllowEditing="True"
                                                    HorizontalHeaderContentAlignment="Right">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N4"
                                                                  HorizontalContentAlignment="Right" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="PlannedVolumesTreeListView"
                                                      KeyFieldName="WorkDirectionId"
                                                      ParentFieldName="ParentId"
                                                      NavigationStyle="Cell"
                                                      AllowEditing="True"
                                                      AutoExpandAllNodes="False"
                                                      ShowHorizontalLines="True"
                                                      ShowVerticalLines="False"
                                                      AutoWidth="True"
                                                      ShowTotalSummary="True"
                                                      TotalSummaryPosition="Bottom"
                                                      ShowingEditor="PlannedVolumesTreeListView_OnShowingEditor" />
                                </dxg:GridControl.View>
                                <dxg:GridControl.TotalSummary>
                                    <dxg:GridSummaryItem FieldName="PlannedVolume"
                                                         SummaryType="Sum"
                                                         Alignment="Right"
                                                         DisplayFormat="Итого: {0:N4}" />
                                </dxg:GridControl.TotalSummary>
                            </dxg:GridControl>
                        </Border>
                    </Grid>
                </Border>

                <!-- Section 3: Labor Hours by Scenario -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SectionHeaderBorderStyle}"
                                ToolTip="Сценарии трудозатрат (оптимистичный / базовый / пессимистичный). Сверка с блоком сценариев на листе «Прогноз» (PEPM_metric).">
                            <TextBlock Text="Расчёт трудоёмкости по сценариям" Style="{StaticResource SectionHeaderTextStyle}" />
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SectionContentBorderStyle}">
                            <dxg:GridControl ItemsSource="{Binding Scenarios, Mode=OneWay}"
                                             AutoGenerateColumns="None"
                                             MaxHeight="350">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="ScenarioName"
                                                    Header="Сценарий"
                                                    Width="180" />
                                    <dxg:GridColumn FieldName="ZScore"
                                                    Header="Z-коэффициент"
                                                    Width="120">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N1" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="TotalLaborHours"
                                                    Header="Общие трудозатраты"
                                                    Width="160">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N0" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.DetailDescriptor>
                                    <dxg:DataControlDetailDescriptor>
                                        <dxg:DataControlDetailDescriptor.DataControl>
                                            <dxg:GridControl ItemsSource="{Binding Disciplines}"
                                                             AutoGenerateColumns="None">
                                                <dxg:GridControl.Columns>
                                                    <dxg:GridColumn FieldName="HierarchyPath"
                                                                    Header="Группа физ. объёмов (ИИС)"
                                                                    Width="320" />
                                                    <dxg:GridColumn FieldName="OptimisticHours"
                                                                    Header="Оптимистичный"
                                                                    Width="140">
                                                        <dxg:GridColumn.EditSettings>
                                                            <dxe:TextEditSettings DisplayFormat="N0"
                                                                                  HorizontalContentAlignment="Right" />
                                                        </dxg:GridColumn.EditSettings>
                                                    </dxg:GridColumn>
                                                    <dxg:GridColumn FieldName="BaseHours"
                                                                    Header="Базовый"
                                                                    Width="130">
                                                        <dxg:GridColumn.EditSettings>
                                                            <dxe:TextEditSettings DisplayFormat="N0"
                                                                                  HorizontalContentAlignment="Right" />
                                                        </dxg:GridColumn.EditSettings>
                                                    </dxg:GridColumn>
                                                    <dxg:GridColumn FieldName="PessimisticHours"
                                                                    Header="Пессимистичный"
                                                                    Width="150">
                                                        <dxg:GridColumn.EditSettings>
                                                            <dxe:TextEditSettings DisplayFormat="N0"
                                                                                  HorizontalContentAlignment="Right" />
                                                        </dxg:GridColumn.EditSettings>
                                                    </dxg:GridColumn>
                                                    <dxg:GridColumn FieldName="Range"
                                                                    Header="Диапазон"
                                                                    Width="120" />
                                                </dxg:GridControl.Columns>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView Name="ScenarioDisciplinesTableView"
                                                                   NavigationStyle="Row"
                                                                   AllowEditing="False"
                                                                   ShowHorizontalLines="True"
                                                                   ShowVerticalLines="False"
                                                                   AutoWidth="True"
                                                                   ShowTotalSummary="True"
                                                                   TotalSummaryPosition="Bottom">
                                                    </dxg:TableView>
                                                </dxg:GridControl.View>
                                                <dxg:GridControl.TotalSummary>
                                                    <dxg:GridSummaryItem FieldName="OptimisticHours"
                                                                         SummaryType="Sum"
                                                                         Alignment="Right"
                                                                         DisplayFormat="Итого: {0:N0}" />
                                                    <dxg:GridSummaryItem FieldName="BaseHours"
                                                                         SummaryType="Sum"
                                                                         Alignment="Right"
                                                                         DisplayFormat="Итого: {0:N0}" />
                                                    <dxg:GridSummaryItem FieldName="PessimisticHours"
                                                                         SummaryType="Sum"
                                                                         Alignment="Right"
                                                                         DisplayFormat="Итого: {0:N0}" />
                                                </dxg:GridControl.TotalSummary>
                                            </dxg:GridControl>
                                        </dxg:DataControlDetailDescriptor.DataControl>
                                    </dxg:DataControlDetailDescriptor>
                                </dxg:GridControl.DetailDescriptor>
                                <dxg:GridControl.View>
                                    <dxg:TableView Name="ScenariosTableView"
                                                   NavigationStyle="Row"
                                                   AllowEditing="False"
                                                   ShowHorizontalLines="True"
                                                   ShowVerticalLines="False"
                                                   AutoWidth="True"
                                                   ShowTotalSummary="True"
                                                   TotalSummaryPosition="Bottom">
                                        <dxg:TableView.FormatConditions>
                                            <dxg:FormatCondition FieldName="ScenarioName"
                                                                 ValueRule="Equal"
                                                                 Value1="Оптимистичный">
                                                <dxg:FormatCondition.Format>
                                                    <dx:Format Background="#E8F5E9" />
                                                </dxg:FormatCondition.Format>
                                            </dxg:FormatCondition>
                                            <dxg:FormatCondition FieldName="ScenarioName"
                                                                 ValueRule="Equal"
                                                                 Value1="Базовый">
                                                <dxg:FormatCondition.Format>
                                                    <dx:Format Background="#E3F2FD" />
                                                </dxg:FormatCondition.Format>
                                            </dxg:FormatCondition>
                                            <dxg:FormatCondition FieldName="ScenarioName"
                                                                 ValueRule="Equal"
                                                                 Value1="Пессимистичный">
                                                <dxg:FormatCondition.Format>
                                                    <dx:Format Background="#FFF3E0" />
                                                </dxg:FormatCondition.Format>
                                            </dxg:FormatCondition>
                                        </dxg:TableView.FormatConditions>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                                <dxg:GridControl.TotalSummary>
                                    <dxg:GridSummaryItem FieldName="TotalLaborHours"
                                                         SummaryType="Sum"
                                                         Alignment="Right"
                                                         DisplayFormat="Итого: {0:N0}" />
                                </dxg:GridControl.TotalSummary>
                            </dxg:GridControl>
                        </Border>
                    </Grid>
                </Border>

                <!-- Section 4: Interpretation & Recommendations -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SectionHeaderBorderStyle}"
                                ToolTip="Интерпретация по сценариям. Сверка с блоком интерпретации на листе «Прогноз» (PEPM_metric).">
                            <TextBlock Text="Интерпретация и рекомендации" Style="{StaticResource SectionHeaderTextStyle}" />
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SectionContentBorderStyle}">
                            <dxg:GridControl ItemsSource="{Binding Interpretations, Mode=OneWay}"
                                             AutoGenerateColumns="None"
                                             MaxHeight="250">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="ScenarioName"
                                                    Header="Сценарий"
                                                    Width="160" />
                                    <dxg:GridColumn FieldName="LaborHours"
                                                    Header="Трудозатраты"
                                                    Width="130">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N0" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="PercentOfBase"
                                                    Header="% от базового"
                                                    Width="130">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N1" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Interpretation"
                                                    Header="Интерпретация"
                                                    Width="400" />
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView Name="InterpretationsTableView"
                                                   NavigationStyle="Row"
                                                   AllowEditing="False"
                                                   ShowHorizontalLines="True"
                                                   ShowVerticalLines="False"
                                                   AutoWidth="True">
                                        <dxg:TableView.FormatConditions>
                                            <dxg:FormatCondition FieldName="ScenarioName"
                                                                 ValueRule="Equal"
                                                                 Value1="Оптимистичный">
                                                <dxg:FormatCondition.Format>
                                                    <dx:Format Background="#4CAF50" Foreground="#FFFFFF" />
                                                </dxg:FormatCondition.Format>
                                            </dxg:FormatCondition>
                                            <dxg:FormatCondition FieldName="ScenarioName"
                                                                 ValueRule="Equal"
                                                                 Value1="Базовый">
                                                <dxg:FormatCondition.Format>
                                                    <dx:Format Background="#3498DB" Foreground="#FFFFFF" />
                                                </dxg:FormatCondition.Format>
                                            </dxg:FormatCondition>
                                            <dxg:FormatCondition FieldName="ScenarioName"
                                                                 ValueRule="Equal"
                                                                 Value1="Пессимистичный">
                                                <dxg:FormatCondition.Format>
                                                    <dx:Format Background="#FF9800" Foreground="#FFFFFF" />
                                                </dxg:FormatCondition.Format>
                                            </dxg:FormatCondition>
                                        </dxg:TableView.FormatConditions>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </Border>
                    </Grid>
                </Border>

                <!-- Section 5: Top-3 Disciplines by Labor Hours -->
                <Border Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SectionHeaderBorderStyle}"
                                ToolTip="Ведущие группы ИИС по базовым трудозатратам. Сверка с блоком ТОП на листе «Прогноз» (PEPM_metric).">
                            <TextBlock Text="ТОП-3 дисциплины по трудозатратам" Style="{StaticResource SectionHeaderTextStyle}" />
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SectionContentBorderStyle}">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Top3Disciplines, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8F9FA"
                                                    CornerRadius="4"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8"
                                                    BorderBrush="#E0E0E0"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Rank Badge -->
                                                    <Border Grid.Column="0"
                                                            Width="32" Height="32"
                                                            CornerRadius="16"
                                                            Background="#2C3E50"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Rank, Mode=OneWay}"
                                                                   Foreground="#FFFFFF"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Discipline Name -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DisciplineName, Mode=OneWay}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#2C3E50"
                                                               VerticalAlignment="Center" />

                                                    <!-- Labor Hours -->
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#3498DB"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding BaseHours, Mode=OneWay, StringFormat={}{0:N0} ч}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty state -->
                                <TextBlock Text="Нет данных по дисциплинам"
                                           FontSize="13"
                                           Foreground="#95A5A6"
                                           FontStyle="Italic"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Top3Disciplines.Count, Mode=OneWay}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
