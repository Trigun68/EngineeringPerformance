<UserControl x:Class="EngineeringPerformance.App.Views.ProjectLaborIntensitiesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Все загруженные строки из таблицы трудоёмкости по проектам (первоисточник в БД)."
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Foreground="#5D6D7E" />

        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Command="{Binding RefreshCommand}"
                    Margin="0,0,12,0"
                    Padding="8,4"
                    ToolTip="Обновить из базы">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/icons8-update-100.png" Width="18" Height="18" Margin="0,0,6,0" />
                    <TextBlock Text="Обновить" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                <Run Text="Записей:" />
                <Run Text="{Binding RowCount, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="Crimson"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </DockPanel>

        <dxg:GridControl Grid.Row="2"
                         ItemsSource="{Binding Items}"
                         AutoGenerateColumns="None">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="Id" Header="Id" Width="56" />
                <dxg:GridColumn FieldName="Project.Code" Header="Код проекта" Width="100" />
                <dxg:GridColumn FieldName="Project.Name" Header="Проект" Width="160" />
                <dxg:GridColumn FieldName="ProjectAnalysisVersion.VersionName" Header="Версия" Width="120" />
                <dxg:GridColumn FieldName="ProjectAnalysisVersion.DirectionName" Header="Направление" Width="90" />
                <dxg:GridColumn FieldName="DocumentationCode" Header="Код док." Width="110" />
                <dxg:GridColumn FieldName="WorkDirection.Code" Header="Код напр." Width="90" />
                <dxg:GridColumn FieldName="WorkDirection.Name" Header="Направление (IIC)" Width="*" MinWidth="140" />
                <dxg:GridColumn FieldName="PlannedHours" Header="План, чел·ч" Width="110">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="N4"
                                              HorizontalContentAlignment="Right" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="ActualHours" Header="Факт, чел·ч" Width="110">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="N4"
                                              HorizontalContentAlignment="Right" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Brand" Header="Марка" Width="100" />
                <dxg:GridColumn FieldName="PhysicalVolume.Code" Header="Код физ. объёма" Width="120" />
                <dxg:GridColumn FieldName="PhysicalVolume.Name" Header="Физ. объём" Width="160" />
                <dxg:GridColumn FieldName="Notes" Header="Примечания" Width="200" />
                <dxg:GridColumn FieldName="CreatedAt" Header="Создано" Width="130">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="g" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="ModifiedAt" Header="Изменено" Width="130">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="g" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView AllowEditing="False"
                               NavigationStyle="Row"
                               ShowGroupPanel="False"
                               ShowHorizontalLines="True"
                               ShowVerticalLines="False"
                               AutoWidth="False" />
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
