<Window x:Class="EngineeringPerformance.App.Views.ProjectParticipantsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="Участники проекта"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="Участники проекта" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Тулбар -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Command="{Binding RequestAddParticipantCommand}"
                            Width="32" Height="32" Padding="4" Margin="0,0,4,0"
                            ToolTip="Добавить участника">
                        <Image Source="/Assets/icons8-add-96.png" />
                    </Button>
                    <Button Command="{Binding RemoveParticipantCommand}"
                            Width="32" Height="32" Padding="4"
                            ToolTip="Удалить участника">
                        <Image Source="/Assets/icons8-delete-96.png" />
                    </Button>
                </StackPanel>

                <!-- Список участников -->
                <dxg:GridControl Grid.Row="1" ItemsSource="{Binding Participants}"
                                 SelectedItem="{Binding SelectedParticipant}"
                                 AutoGenerateColumns="None">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="UserName" Header="Имя" Width="*" />
                        <dxg:GridColumn FieldName="Role" Header="Роль" Width="100" />
                        <dxg:GridColumn FieldName="AccessLevelDisplay" Header="Доступ" Width="90" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowEditing="False" NavigationStyle="Row"
                                       ShowGroupPanel="False" AutoWidth="False"
                                       ShowVerticalLines="False" />
                    </dxg:GridControl.View>
                </dxg:GridControl>

                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="Red"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Закрыть" Command="{Binding CloseCommand}"
                            MinWidth="100" Padding="12,8" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
