<Window x:Class="EngineeringPerformance.App.Views.ProjectEquipmentCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="{Binding WindowTitle}"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="{Binding WindowTitle}" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Номенклатура оборудования" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <dxe:ComboBoxEdit Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding EquipmentDisplayItems}"
                                          EditValue="{Binding SelectedEquipmentId}"
                                          ValueMember="Id"
                                          DisplayMember="Display"
                                          Style="{StaticResource LookupComboBoxEdit}"
                                          NullText="Не выбрано"
                                          Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Количество" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <dxe:SpinEdit Grid.Row="1" Grid.Column="1"
                                      EditValue="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                      MinValue="0" MaxValue="999999999" Increment="1"
                                      IsFloatValue="True" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Код объекта" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <dxe:TextEdit Grid.Row="2" Grid.Column="1"
                                      EditValue="{Binding FacilityCode, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Наименование объекта" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <dxe:TextEdit Grid.Row="3" Grid.Column="1"
                                      EditValue="{Binding FacilityName, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,8" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Комплект документации" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <dxe:TextEdit Grid.Row="4" Grid.Column="1"
                                      EditValue="{Binding DocumentSet, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,8" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="ID каталога" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <dxe:TextEdit Grid.Row="5" Grid.Column="1"
                                      EditValue="{Binding CatalogId, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,8" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Тэг" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <dxe:TextEdit Grid.Row="6" Grid.Column="1"
                                      EditValue="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,8" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Основание оценки" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <dxe:TextEdit Grid.Row="7" Grid.Column="1"
                                      EditValue="{Binding EstimationBasis, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,8" />
                    </Grid>
                </ScrollViewer>

                <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Margin="0,0,8,0" IsDefault="True" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
