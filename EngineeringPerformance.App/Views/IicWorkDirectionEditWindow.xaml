<Window x:Class="EngineeringPerformance.App.Views.IicWorkDirectionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="{Binding WindowTitle}"
        Height="380" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="{Binding WindowTitle}" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Код" VerticalAlignment="Center" Margin="0,0,8,8" />
        <dxe:TextEdit Grid.Row="0" Grid.Column="1" EditValue="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование" VerticalAlignment="Center" Margin="0,0,8,8" />
        <dxe:TextEdit Grid.Row="1" Grid.Column="1" EditValue="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание" VerticalAlignment="Center" Margin="0,0,8,8" />
        <dxe:TextEdit Grid.Row="2" Grid.Column="1" EditValue="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ед. измерения" VerticalAlignment="Center" Margin="0,0,8,8" />
        <dxe:ComboBoxEdit Grid.Row="3" Grid.Column="1"
                          ItemsSource="{Binding Units}"
                          EditValue="{Binding SelectedUnitId}"
                          ValueMember="Id"
                          DisplayMember="DisplayText"
                          IsTextEditable="False"
                          IsEnabled="{Binding AreLookupsReady}"
                          Margin="0,0,0,8"
                          NullText="(не выбрано)" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Родитель" VerticalAlignment="Center" Margin="0,0,8,8" />
        <dxe:ComboBoxEdit Grid.Row="4" Grid.Column="1"
                          ItemsSource="{Binding Parents}"
                          EditValue="{Binding SelectedParentId}"
                          ValueMember="Id"
                          DisplayMember="DisplayText"
                          IsTextEditable="False"
                          IsEnabled="{Binding AreLookupsReady}"
                          Margin="0,0,0,8"
                          NullText="(не выбрано)" />

        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Margin="0,0,8,0" IsDefault="True" IsEnabled="{Binding AreLookupsReady}" />
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" IsCancel="True" />
        </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
