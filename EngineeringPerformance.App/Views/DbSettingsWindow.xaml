<Window x:Class="EngineeringPerformance.App.Views.DbSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
        xmlns:vm="clr-namespace:EngineeringPerformance.App.ViewModels"
        mc:Ignorable="d"
        Title="Настройки подключения к базе данных" Height="460" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/logo.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Параметры подключения" FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="Сервер:" Margin="0,0,0,4" />
            <dxe:TextEdit EditValue="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,12" />

            <TextBlock Text="База данных:" Margin="0,0,0,4" />
            <dxe:TextEdit EditValue="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,12" />

            <CheckBox Content="Использовать аутентификацию Windows"
                      IsChecked="{Binding UseWindowsAuth}" Margin="0,0,0,12" />

            <StackPanel Visibility="{Binding UseWindowsAuth, Converter={dxmvvm:BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="Имя пользователя БД:" Margin="0,0,0,4" />
                <dxe:TextEdit EditValue="{Binding DbUsername, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,8" />

                <TextBlock Text="Пароль БД:" Margin="0,0,0,4" />
                <dxe:PasswordBoxEdit EditValue="{Binding DbPassword, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12" />
            </StackPanel>

            <CheckBox Content="Доверять серверному сертификату (TrustServerCertificate)"
                      IsChecked="{Binding TrustServerCertificate}"
                      ToolTip="Включайте только для локального SQL Server (LocalDB/Express). Для удалённого сервера небезопасно."
                      Margin="0,0,0,8" />

            <CheckBox Content="Авто-вход по Windows-пользователю (без пароля)"
                      IsChecked="{Binding AutoLoginEnabled}"
                      ToolTip="При включении авторизация выполняется по Windows-логину без подтверждения. Не рекомендуется на общих ПК."
                      Margin="0,0,0,12" />

            <Button Content="Проверить соединение" Width="160" Height="30"
                    HorizontalAlignment="Left"
                    Command="{Binding TestConnectionCommand}"
                    IsEnabled="{Binding IsTesting, Converter={dxmvvm:BooleanNegationConverter}}" />

            <TextBlock Text="{Binding ConnectionStatus}" Margin="0,8,0,0"
                       Foreground="{Binding ConnectionStatusColor}" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить" Width="100" Height="30" Margin="0,0,8,0"
                    Command="{Binding SaveSettingsCommand}" />
            <Button Content="Отмена" Width="100" Height="30"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
