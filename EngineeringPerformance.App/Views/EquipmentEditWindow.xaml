<Window x:Class="EngineeringPerformance.App.Views.EquipmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="{Binding WindowTitle}"
        Height="520" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="{Binding WindowTitle}" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование" VerticalAlignment="Center" Margin="0,0,8,8" />
                <dxe:TextEdit Grid.Row="0" Grid.Column="1" EditValue="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Описание" VerticalAlignment="Center" Margin="0,0,8,8" />
                <dxe:TextEdit Grid.Row="1" Grid.Column="1" EditValue="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Классификатор" VerticalAlignment="Center" Margin="0,0,8,8" />
                <dxe:ComboBoxEdit Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding ClassifierDisplayItems}"
                                  SelectedItem="{Binding SelectedClassifierItem}"
                                  DisplayMember="Display"
                                  IsEnabled="{Binding AreLookupsReady}"
                                  IsTextEditable="False"
                                  Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Родитель" VerticalAlignment="Center" Margin="0,0,8,8" />
                <dxe:ComboBoxEdit Grid.Row="3" Grid.Column="1"
                                  ItemsSource="{Binding ParentDisplayItems}"
                                  SelectedItem="{Binding SelectedParentItem}"
                                  DisplayMember="Display"
                                  IsEnabled="{Binding AreLookupsReady}"
                                  IsTextEditable="False"
                                  Margin="0,0,0,8" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ед. изм." VerticalAlignment="Center" Margin="0,0,8,8" />
                <dxe:ComboBoxEdit Grid.Row="4" Grid.Column="1"
                                  ItemsSource="{Binding Units}"
                                  SelectedItem="{Binding SelectedUnit}"
                                  DisplayMember="Name"
                                  IsEnabled="{Binding AreLookupsReady}"
                                  IsTextEditable="False"
                                  Margin="0,0,0,8" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Коэффициент" VerticalAlignment="Center" Margin="0,0,8,8" />
                <dxe:SpinEdit Grid.Row="5" Grid.Column="1"
                              EditValue="{Binding Coefficient, UpdateSourceTrigger=PropertyChanged}"
                              MinValue="0.0001"
                              MaxValue="1000000"
                              Increment="0.0001"
                              IsFloatValue="True"
                              Margin="0,0,0,8" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Оценка" VerticalAlignment="Center" Margin="0,0,8,8" />
                <dxe:ComboBoxEdit Grid.Row="6" Grid.Column="1"
                                  ItemsSource="{Binding AssessmentOptions}"
                                  SelectedItem="{Binding SelectedAssessmentItem}"
                                  DisplayMember="Display"
                                  IsTextEditable="False"
                                  Margin="0,0,0,8" />

                <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />

                <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Margin="0,0,8,0" IsDefault="True" IsEnabled="{Binding AreLookupsReady}" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
