<Window x:Class="EngineeringPerformance.App.Views.ProjectDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="Основные данные проекта"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="Основные данные проекта" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <!-- Заголовок 1 -->
                            <RowDefinition Height="Auto" />
                            <!-- Код -->
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <!-- Название -->
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <!-- Номер работы -->
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <!-- ГИП -->
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <!-- Начало работы -->
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <!-- Статус -->
                            <RowDefinition Height="16" />
                            <!-- Заголовок 2 -->
                            <RowDefinition Height="Auto" />
                            <!-- Номер договора -->
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <!-- Номер калд. плана -->
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <!-- Тип -->
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <!-- Заказчик -->
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <!-- Подрядчик -->
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <!-- Программа -->
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Раздел: Основные данные -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="#EBF5FB" CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                            <TextBlock Text="Основные данные" FontWeight="SemiBold" Foreground="#1A5276" />
                        </Border>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Код" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="2" Grid.Column="1"
                                      EditValue="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Название" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="4" Grid.Column="1"
                                      EditValue="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Номер работы" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="6" Grid.Column="1"
                                      EditValue="{Binding WorkNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="ГИП" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="8" Grid.Column="1"
                                      EditValue="{Binding Gip, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Начало работы" VerticalAlignment="Center" />
                        <dxe:DateEdit Grid.Row="10" Grid.Column="1"
                                      EditValue="{Binding WorkStart, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayFormatString="dd.MM.yyyy"
                                      MaskUseAsDisplayFormat="True" />

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Статус работы" VerticalAlignment="Center" />
                        <dxe:ComboBoxEdit Grid.Row="12" Grid.Column="1"
                                          EditValue="{Binding WorkStatus, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding WorkStatusItems}"
                                          IsTextEditable="False" />

                        <!-- Раздел: Дополнительные данные -->
                        <Border Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="#EBF5FB" CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                            <TextBlock Text="Дополнительные данные" FontWeight="SemiBold" Foreground="#1A5276" />
                        </Border>

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Номер договора" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="14" Grid.Column="1"
                                      EditValue="{Binding ContractNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="16" Grid.Column="0" Text="Номер калд. плана" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="16" Grid.Column="1"
                                      EditValue="{Binding CalendarPlanNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="18" Grid.Column="0" Text="Тип" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="18" Grid.Column="1"
                                      EditValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="20" Grid.Column="0" Text="Заказчик" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="20" Grid.Column="1"
                                      EditValue="{Binding Customer, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="22" Grid.Column="0" Text="Подрядчик" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="22" Grid.Column="1"
                                      EditValue="{Binding Contractor, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="24" Grid.Column="0" Text="Программа" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="24" Grid.Column="1"
                                      EditValue="{Binding Program, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </ScrollViewer>

                <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}"
                            MinWidth="120" Padding="12,8" Margin="0,0,8,0" IsDefault="True" />
                    <Button Content="Закрыть" Command="{Binding CancelCommand}"
                            MinWidth="120" Padding="12,8" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
