<Window x:Class="EngineeringPerformance.App.Views.ProjectPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="Выбор проекта"
        Height="520" Width="620"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="Выбор проекта" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Тулбар: добавить / редактировать / удалить / в архив / из архива -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Command="{Binding AddProjectCommand}"
                            Width="32" Height="32" Padding="4" Margin="0,0,4,0"
                            ToolTip="Добавить проект">
                        <Image Source="/Assets/icons8-add-96.png" />
                    </Button>
                    <Button Command="{Binding EditProjectCommand}"
                            Width="32" Height="32" Padding="4" Margin="0,0,4,0"
                            ToolTip="Редактировать проект">
                        <Image Source="/Assets/icons8-edit-90.png" />
                    </Button>
                    <Button Command="{Binding DeleteProjectCommand}"
                            Width="32" Height="32" Padding="4" Margin="0,0,12,0"
                            ToolTip="Удалить проект">
                        <Image Source="/Assets/icons8-delete-96.png" />
                    </Button>
                    <Button Command="{Binding ArchiveProjectCommand}"
                            Width="32" Height="32" Padding="4" Margin="0,0,4,0"
                            ToolTip="В архив">
                        <Image Source="/Assets/icons8-pack-luggage-100.png" />
                    </Button>
                    <Button Command="{Binding UnarchiveProjectCommand}"
                            Width="32" Height="32" Padding="4" Margin="0,0,16,0"
                            ToolTip="Из архива">
                        <Image Source="/Assets/icons8-unpack-luggage-100.png" />
                    </Button>
                    <CheckBox Content="Показывать архивные"
                              IsChecked="{Binding ShowArchived}"
                              VerticalAlignment="Center" />
                </StackPanel>

                <!-- Поиск -->
                <Border Grid.Row="1" Height="34" Margin="0,0,0,8"
                        BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="2" ClipToBounds="True">
                    <dxe:TextEdit VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                  MinHeight="0" MaxHeight="34" BorderThickness="0" ShowBorder="False"
                                  EditValue="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                  NullText="Поиск по коду или названию..." />
                </Border>

                <!-- Ошибка -->
                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="Red"
                           TextWrapping="Wrap" Margin="0,0,0,4"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

                <!-- Список проектов -->
                <dxg:GridControl Grid.Row="3"
                                 ItemsSource="{Binding FilteredProjects}"
                                 SelectedItem="{Binding SelectedProject}"
                                 AutoGenerateColumns="None"
                                 MouseDoubleClick="Grid_MouseDoubleClick">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Code" Header="Код" Width="100" />
                        <dxg:GridColumn FieldName="Name" Header="Наименование" Width="*" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowEditing="False" NavigationStyle="Row"
                                       ShowGroupPanel="False" AutoWidth="False"
                                       ShowHorizontalLines="True" ShowVerticalLines="False" />
                    </dxg:GridControl.View>
                </dxg:GridControl>

                <!-- Кнопки -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Выбрать" Command="{Binding SelectCommand}"
                            MinWidth="100" Padding="12,8" Margin="0,0,8,0" IsDefault="True" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}"
                            MinWidth="100" Padding="12,8" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
