<UserControl x:Class="EngineeringPerformance.App.Views.ProjectDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Главная" FontSize="22" FontWeight="SemiBold"
                   Foreground="#2C3E50" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Интерпретация стандартного отклонения (σ)"
                           FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,10" />

                <!-- Двухколоночная компоновка: картинка слева, методология справа -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка: картинка + подпись -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <Border Background="#FFFFFF" CornerRadius="10" Padding="12"
                                BorderBrush="#E2E8F0" BorderThickness="1" MaxWidth="567">
                            <Image Source="pack://application:,,,/Assets/standard-deviation-interpretation.png"
                                   Stretch="Uniform"
                                   MaxWidth="541"
                                   HorizontalAlignment="Left"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="Рисунок: распределение значения в диапазоне от −1σ до +1σ; цветовая шкала соответствует положению относительно среднего (0)."
                                   FontSize="12" Foreground="#94A3B8" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="567" />
                    </StackPanel>

                    <!-- Правая колонка: описание методологии -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="Методология оценки проектов"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,12" />
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="20,18"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#334155" FontSize="14" LineHeight="22"
                                           Margin="0,0,0,14">
                                    <Run FontWeight="SemiBold" Text="Базовая идея. " />
                                    <Run Text="Фактическая производительность по направлению ИИС сравнивается с нормативом, зафиксированным в снимке версии анализа. Для сопоставимости используется логарифм фактической производительности (часы на единицу объёма в единицах группы ИИС) — «оценка факта»; норма задаётся оценкой и стандартным отклонением нормы по тому же масштабу." />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="#334155" FontSize="14" LineHeight="22"
                                           Margin="0,0,0,14">
                                    <Run FontWeight="SemiBold" Text="Z-score. " />
                                    <Run Text="Величина Z = (оценка факта − оценка нормы) / σ нормы показывает, на сколько стандартных отклонений факт отклоняется от нормы. В приложении меньшее Z (в сторону отрицательных значений) соответствует меньшим часам на единицу объёма, то есть более высокой производительности относительно нормы." />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="#334155" FontSize="14" LineHeight="22">
                                    <Run FontWeight="SemiBold" Text="Интерпретация в системе. " />
                                    <Run Text="Категории на вкладках анализа и в отчётах выводятся по порогам Z: Z &lt; −1 — отличная производительность; −1 ≤ Z &lt; −0,5 — хорошая; −0,5 ≤ Z ≤ 0,5 — удовлетворительная; 0,5 &lt; Z ≤ 1 — требует внимания; Z &gt; 1 — критически низкая производительность. Рисунок слева иллюстрирует положение значения в диапазоне ±1σ относительно нуля (среднее нормы)." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
