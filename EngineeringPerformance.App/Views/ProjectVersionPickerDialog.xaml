<Window x:Class="EngineeringPerformance.App.Views.ProjectVersionPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="{Binding WindowTitle}"
        Height="440" Width="560"
        MinHeight="320" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="{Binding WindowTitle}" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Тулбар: добавить / редактировать / удалить -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Command="{Binding AddVersionCommand}"
                            Width="32" Height="32" Padding="4" Margin="0,0,4,0"
                            ToolTip="Добавить версию">
                        <Image Source="/Assets/icons8-add-96.png" />
                    </Button>
                    <Button Command="{Binding EditVersionCommand}"
                            Width="32" Height="32" Padding="4" Margin="0,0,4,0"
                            ToolTip="Редактировать версию">
                        <Image Source="/Assets/icons8-edit-90.png" />
                    </Button>
                    <Button Command="{Binding DeleteVersionCommand}"
                            Width="32" Height="32" Padding="4"
                            ToolTip="Удалить версию">
                        <Image Source="/Assets/icons8-delete-96.png" />
                    </Button>
                </StackPanel>

                <!-- Список версий -->
                <dxg:GridControl Grid.Row="1"
                                 ItemsSource="{Binding Versions}"
                                 SelectedItem="{Binding SelectedVersion}"
                                 AutoGenerateColumns="None"
                                 MouseDoubleClick="Grid_MouseDoubleClick">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="VersionName" Header="Наименование версии" Width="*" />
                        <dxg:GridColumn FieldName="Direction" Header="Тип" Width="80">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RowData.Row.Direction,
                                        Converter={StaticResource AnalysisDirectionToString}}"
                                               HorizontalAlignment="Center" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Description" Header="Описание" Width="2*" />
                        <dxg:GridColumn FieldName="CreatedAt" Header="Дата создания" Width="140">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="dd.MM.yyyy HH:mm" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowEditing="False" NavigationStyle="Row"
                                       ShowGroupPanel="False" AutoWidth="False"
                                       ShowHorizontalLines="True" ShowVerticalLines="False" />
                    </dxg:GridControl.View>
                </dxg:GridControl>

                <!-- Ошибка -->
                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="Red"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

                <!-- Кнопки -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Выбрать" Command="{Binding SelectCommand}"
                            MinWidth="100" Padding="12,8" Margin="0,0,8,0" IsDefault="True" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}"
                            MinWidth="100" Padding="12,8" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
