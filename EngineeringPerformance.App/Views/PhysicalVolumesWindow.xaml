<UserControl x:Class="EngineeringPerformance.App.Views.PhysicalVolumesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <Button DockPanel.Dock="Left" Command="{Binding CreateAndEditCommand}" Margin="0,0,4,0" ToolTip="Добавить">
                <Image Source="/Assets/icons8-add-96.png" Width="20" Height="20" />
            </Button>
            <Button DockPanel.Dock="Left" Command="{Binding EditItemCommand}" Margin="0,0,4,0" ToolTip="Редактировать">
                <Image Source="/Assets/icons8-edit-90.png" Width="20" Height="20" />
            </Button>
            <Button DockPanel.Dock="Left" Command="{Binding DeleteItemCommand}" Margin="0,0,4,0" ToolTip="Удалить">
                <Image Source="/Assets/icons8-delete-96.png" Width="20" Height="20" />
            </Button>
            <Button DockPanel.Dock="Left" Command="{Binding ArchiveItemCommand}" Margin="0,0,4,0" ToolTip="В архив">
                <Image Source="/Assets/icons8-pack-luggage-100.png" Width="20" Height="20" />
            </Button>
            <Button DockPanel.Dock="Left" Command="{Binding UnarchiveItemCommand}" Margin="0,0,4,0" ToolTip="Из архива">
                <Image Source="/Assets/icons8-unpack-luggage-100.png" Width="20" Height="20" />
            </Button>
            <Separator DockPanel.Dock="Left" Margin="4,0" />
            <Button DockPanel.Dock="Left" Command="{Binding RefreshCommand}" Margin="0,0,4,0" ToolTip="Обновить">
                <Image Source="/Assets/icons8-update-100.png" Width="20" Height="20" />
            </Button>
            <CheckBox DockPanel.Dock="Left" Content="Показать архивные" IsChecked="{Binding ShowArchived}"
                      VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Command="{Binding ExportToExcelCommand}" ToolTip="Выгрузить в Excel">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/icons8-save-96.png" Width="20" Height="20" Margin="0,0,4,0" />
                    <TextBlock Text="Выгрузить в Excel" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Вид:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <dxe:ComboBoxEdit ItemsSource="{Binding VolumeTypes}"
                              EditValue="{Binding SelectedVolumeTypeIdFilter}"
                              ValueMember="Id"
                              DisplayMember="Name"
                              Width="200"
                              Margin="0,0,8,0"
                              NullText="Все" />
            <TextBlock Text="Оценка:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <dxe:ComboBoxEdit ItemsSource="{Binding AssessmentFilterOptions}"
                              EditValue="{Binding SelectedAssessmentFilterOption}"
                              ValueMember="Value"
                              DisplayMember="Display"
                              Width="120"
                              Margin="0,0,8,0"
                              NullText="Все" />
        </StackPanel>

        <dxg:GridControl Grid.Row="2" ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         AutoGenerateColumns="None"
                         MouseDoubleClick="GridControl_MouseDoubleClick"
                         RestoreStateOnSourceChange="True"
                         RestoreStateKeyFieldName="Id">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="Code" Header="Код" Width="120" />
                <dxg:GridColumn FieldName="Name" Header="Наименование" Width="300" />
                <dxg:GridColumn FieldName="Description" Header="Описание" Width="200" />
                <dxg:GridColumn FieldName="VolumeType.Name" Header="Тип" Width="100" />
                <dxg:GridColumn FieldName="ClassifierNameWithUnit" Header="Классификатор" Width="220" />
                <dxg:GridColumn FieldName="Unit.Name" Header="Ед. изм." Width="100" />
                <dxg:GridColumn FieldName="Coefficient" Header="Коэффициент" Width="100" />
                <dxg:GridColumn FieldName="IsAssessment" Header="Оценка" Width="80" />
                <dxg:GridColumn FieldName="IsArchived" Header="Архив" Width="60" />
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TreeListView x:Name="TreeListView"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentId"
                                  TreeColumnFieldName="Code"
                                  AllowEditing="False"
                                  NavigationStyle="Row"
                                  AutoExpandAllNodes="False"
                                  ShowSearchPanelMode="Always"
                                  SearchPanelHighlightResults="True"
                                  ShowGridMenu="TreeListView_ShowGridMenu"
                                  AllowDragDrop="True"
                                  DropRecord="TreeListView_DropRecord"
                                  CompleteRecordDragDrop="TreeListView_CompleteRecordDragDrop">
                </dxg:TreeListView>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
