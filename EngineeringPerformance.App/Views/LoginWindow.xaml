<Window x:Class="EngineeringPerformance.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
        xmlns:converters="clr-namespace:EngineeringPerformance.App.Converters"
        mc:Ignorable="d"
        Title="Авторизация" Height="480" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="/Assets/logo.png"
        MinWidth="600" MinHeight="400">
    <Window.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <Style x:Key="FlatIconButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C0C0C0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0D1B2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="24,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B2838" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0A1520" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4A5568" />
                    <Setter Property="Foreground" Value="#A0AEC0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:DispatcherService />
    </dxmvvm:Interaction.Behaviors>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Logo Area -->
        <Border Grid.Column="0"
                Background="#0D1B2A"
                CornerRadius="12,0,0,12">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="30">
                <Image Source="/Assets/logo.png"
                       Width="180"
                       Height="180"
                       Stretch="Uniform"
                       Margin="0,0,0,24" />
                <TextBlock Text="Engineering Performance"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="Система управления эффективностью"
                           FontSize="12"
                           Foreground="#8899AA"
                           TextAlignment="Center"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Right Panel - Login Form -->
        <Border Grid.Column="1"
                Background="#F7F8FA"
                CornerRadius="0,12,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="40,32">
                <StackPanel>
                    <TextBlock Text="Авторизация"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0D1B2A"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Введите данные для входа в систему"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,0,0,28" />

                    <!-- Windows Username Display -->
                    <StackPanel Visibility="{Binding HasWindowsUsername, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                Margin="0,0,0,20">
                        <TextBlock Text="Windows-пользователь:"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding WindowsUsername}"
                                   FontSize="13"
                                   Foreground="#374151"
                                   FontStyle="Italic" />
                    </StackPanel>

                    <!-- Username Field -->
                    <TextBlock Text="Имя пользователя"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6" />
                    <dxe:TextEdit EditValue="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                  Height="40"
                                  Margin="0,0,0,16"
                                  FontSize="14">
                        <dxe:TextEdit.Style>
                            <Style TargetType="dxe:TextEdit" BasedOn="{StaticResource {x:Type dxe:TextEdit}}">
                                <Setter Property="BorderBrush" Value="#D1D5DB" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                        </dxe:TextEdit.Style>
                    </dxe:TextEdit>

                    <!-- Password Field -->
                    <TextBlock Text="Пароль"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <dxe:TextEdit Grid.Column="0"
                                      EditValue="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                      Height="40"
                                      Margin="0,0,8,0"
                                      FontSize="14"
                                      Visibility="{Binding PasswordVisible, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                        <dxe:PasswordBoxEdit Grid.Column="0"
                                             EditValue="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                             Height="40"
                                             Margin="0,0,8,0"
                                             FontSize="14"
                                             Visibility="{Binding PasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <Button Grid.Column="1"
                                Width="40"
                                Height="40"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                ToolTip="Показать/скрыть пароль"
                                Style="{StaticResource FlatIconButton}">
                            <Image Source="/Assets/password-hidden.png"
                                   Width="20"
                                   Height="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- Error Message -->
                    <Border Background="#FEE2E2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasErrorMessage, Converter={dxmvvm:BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#DC2626"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Войти"
                                Height="42"
                                HorizontalAlignment="Stretch"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}"
                                Style="{StaticResource LoginButtonStyle}" />
                        <Button Grid.Column="1"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ToolTip="Настройки подключения к БД"
                                Command="{Binding OpenDbSettingsCommand}"
                                Style="{StaticResource FlatIconButton}">
                            <Image Source="/Assets/settings.png"
                                   Width="20"
                                   Height="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>