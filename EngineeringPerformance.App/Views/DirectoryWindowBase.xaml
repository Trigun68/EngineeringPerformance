<UserControl x:Class="EngineeringPerformance.App.Views.DirectoryWindowBase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Command="{Binding CreateItemCommand}" Margin="0,0,4,0" ToolTip="Добавить">
                <Image Source="/Assets/icons8-add-96.png" Width="20" Height="20" />
            </Button>
            <Button Command="{Binding SaveItemCommand}" Margin="0,0,4,0" ToolTip="Сохранить">
                <Image Source="/Assets/icons8-save-96.png" Width="20" Height="20" />
            </Button>
            <Button Command="{Binding DeleteItemCommand}" Margin="0,0,4,0" ToolTip="Удалить">
                <Image Source="/Assets/icons8-delete-96.png" Width="20" Height="20" />
            </Button>
            <Button Command="{Binding ArchiveItemCommand}" Margin="0,0,4,0" ToolTip="В архив">
                <Image Source="/Assets/icons8-pack-luggage-100.png" Width="20" Height="20" />
            </Button>
            <Button Command="{Binding UnarchiveItemCommand}" Margin="0,0,4,0" ToolTip="Из архива">
                <Image Source="/Assets/icons8-unpack-luggage-100.png" Width="20" Height="20" />
            </Button>
            <Separator Margin="4,0" />
            <Button Command="{Binding RefreshCommand}" Margin="0,0,4,0" ToolTip="Обновить">
                <Image Source="/Assets/icons8-update-100.png" Width="20" Height="20" />
            </Button>
            <CheckBox Content="Показать архивные" IsChecked="{Binding ShowArchived}"
                      VerticalAlignment="Center" Margin="0,0,8,0" />
            <dxe:TextEdit EditValue="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                          NullText="Поиск..." Width="200" />
        </StackPanel>

        <!-- Data Grid -->
        <dxg:GridControl Grid.Row="1" ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         AutoGenerateColumns="None">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="Name" Header="Наименование" />
                <dxg:GridColumn FieldName="IsArchived" Header="Архив" Width="60" />
                <dxg:GridColumn FieldName="CreatedAt" Header="Создан" Width="120" />
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView Name="tableView"
                               ShowTotalSummary="False"
                               AllowEditing="False"
                               NavigationStyle="Row" />
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
