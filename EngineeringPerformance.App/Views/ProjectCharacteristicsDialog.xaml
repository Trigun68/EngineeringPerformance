<Window x:Class="EngineeringPerformance.App.Views.ProjectCharacteristicsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="{Binding WindowTitle}"
        Height="500" Width="720"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="{Binding WindowTitle}" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Добавить" Command="{Binding AddRowCommand}" Width="100" Margin="0,0,8,0" />
                    <Button Content="Редактировать" Command="{Binding EditRowCommand}" Width="120" Margin="0,0,8,0" />
                    <Button Content="Удалить" Command="{Binding DeleteRowCommand}" Width="100" />
                </StackPanel>

                <dxg:GridControl Grid.Row="1"
                                 ItemsSource="{Binding Rows}"
                                 SelectedItem="{Binding SelectedRow}"
                                 AutoGenerateColumns="None"
                                 Margin="0,0,0,8">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="CharacteristicName" Header="Наименование характеристики" Width="*" />
                        <dxg:GridColumn FieldName="OptionName" Header="Вариант" Width="*" />
                        <dxg:GridColumn FieldName="ValuePercent" Header="%" Width="80" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowEditing="False"
                                       NavigationStyle="Row"
                                       ShowGroupPanel="False"
                                       AutoWidth="False" />
                    </dxg:GridControl.View>
                </dxg:GridControl>

                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Margin="0,0,8,0" IsDefault="True" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
