<Window x:Class="EngineeringPerformance.App.Views.ProjectAdditionalFieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="Дополнительные данные проекта"
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="Дополнительные данные проекта" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Номер договора" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="0" Grid.Column="1" EditValue="{Binding ContractNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Номер календ. плана" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="2" Grid.Column="1" EditValue="{Binding CalendarPlanNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Тип" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="4" Grid.Column="1" EditValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Заказчик" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="6" Grid.Column="1" EditValue="{Binding Customer, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Подрядчик" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="8" Grid.Column="1" EditValue="{Binding Contractor, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Программа" VerticalAlignment="Center" />
                        <dxe:TextEdit Grid.Row="10" Grid.Column="1" EditValue="{Binding Program, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </ScrollViewer>

                <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="120" Margin="0,0,8,0" IsDefault="True" />
                    <Button Content="Закрыть" Command="{Binding CloseWithoutSaveCommand}" Width="120" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
