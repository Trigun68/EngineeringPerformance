<Window x:Class="EngineeringPerformance.App.Views.ProjectAnalysisVersionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="{Binding WindowTitle}"
        Height="460" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="{Binding WindowTitle}" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Проект" VerticalAlignment="Top" Margin="0,2,8,8" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding ProjectName, Mode=OneWay}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование" VerticalAlignment="Center" Margin="0,0,8,8" />
                <dxe:TextEdit Grid.Row="1" Grid.Column="1" EditValue="{Binding VersionName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Направление анализа" VerticalAlignment="Center" Margin="0,0,8,8" />
                <dxe:ComboBoxEdit Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding DirectionItems}"
                                  EditValue="{Binding SelectedDirection, UpdateSourceTrigger=PropertyChanged}"
                                  ValueMember="Direction"
                                  DisplayMember="DisplayName"
                                  Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Тип справочника физ. объёмов" VerticalAlignment="Center" Margin="0,0,8,8" />
                <dxe:ComboBoxEdit Grid.Row="3" Grid.Column="1"
                                  ItemsSource="{Binding PhysicalVolumeTypes}"
                                  EditValue="{Binding SelectedPhysicalVolumeTypeId}"
                                  ValueMember="Id"
                                  DisplayMember="Name"
                                  IsEnabled="{Binding AreLookupsReady}"
                                  Margin="0,0,0,8"
                                  NullText="Не выбрано" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата создания" VerticalAlignment="Center" Margin="0,0,8,8" />
                <dxe:DateEdit Grid.Row="4" Grid.Column="1" EditValue="{Binding CreatedAt, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />

                <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Margin="0,0,8,0" IsDefault="True" IsEnabled="{Binding AreLookupsReady}" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
