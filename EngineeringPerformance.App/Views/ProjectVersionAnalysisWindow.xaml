<Window x:Class="EngineeringPerformance.App.Views.ProjectVersionAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:converters="clr-namespace:EngineeringPerformance.App.Converters"
        mc:Ignorable="d"
        Title="Анализ версии проекта"
        Height="800" Width="1400"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo.png">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InterpretationToBrushConverter x:Key="InterpretationToBrush" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2C3E50" />
            <Setter Property="Margin" Value="0,8,0,12" />
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#2C3E50" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Шаблон одного направления IIC: заголовок + метрики + список физ. объёмов -->
        <DataTemplate x:Key="DirectionCardTemplate">
            <Border Style="{StaticResource CardStyle}" Margin="{Binding CardMargin}">

                <StackPanel>
                    <!-- Заголовок направления -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#EEF4FF"
                                CornerRadius="4"
                                Padding="6,3"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Code}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#2563EB" />
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ед. изм.:" Foreground="#94A3B8" FontSize="12" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding UnitName, TargetNullValue=—}"
                                       Foreground="#475569" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <!-- Метрики производительности -->
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <UniformGrid Columns="8">
                            <!-- Факт ФО: подсветка если ФО нет, но труд. есть -->
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Факт ФО" Style="{StaticResource MetricLabelStyle}" />
                                <Border CornerRadius="3" Padding="2,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighlightMissingPhysicalVolume}" Value="True">
                                                    <Setter Property="Background" Value="#FFF3CD" />
                                                    <Setter Property="BorderBrush" Value="#FFC107" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding FactPhysicalVolume, StringFormat={}{0:N2}, TargetNullValue=—}"
                                               Style="{StaticResource MetricValueStyle}" />
                                </Border>
                            </StackPanel>
                            <!-- Факт труд.: подсветка если труд. нет, но ФО есть -->
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Факт труд., ч" Style="{StaticResource MetricLabelStyle}" />
                                <Border CornerRadius="3" Padding="2,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighlightMissingLaborHours}" Value="True">
                                                    <Setter Property="Background" Value="#FFF3CD" />
                                                    <Setter Property="BorderBrush" Value="#FFC107" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding FactLaborHours, StringFormat={}{0:N0}, TargetNullValue=—}"
                                               Style="{StaticResource MetricValueStyle}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Факт произв." Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding FactProductivity, StringFormat={}{0:N4}, TargetNullValue=—}"
                                           Style="{StaticResource MetricValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Факт оценка" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding FactEstimate, StringFormat={}{0:N4}, TargetNullValue=—}"
                                           Style="{StaticResource MetricValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Норм произв." Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding NormProductivity, StringFormat={}{0:N4}, TargetNullValue=—}"
                                           Style="{StaticResource MetricValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Норм оценка" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding NormEstimate, StringFormat={}{0:N4}, TargetNullValue=—}"
                                           Style="{StaticResource MetricValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Норм СО" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding NormStdDev, StringFormat={}{0:N4}, TargetNullValue=—}"
                                           Style="{StaticResource MetricValueStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Z-оценка" Style="{StaticResource MetricLabelStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding InterpretationText, Converter={StaticResource InterpretationToBrush}}" />
                                    <TextBlock Text="{Binding ZScore, StringFormat={}{0:N2}, TargetNullValue=—}"
                                               Style="{StaticResource MetricValueStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- Интерпретация результата -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Интерпретация:" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding InterpretationText}"
                                   Margin="8,0,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Два блока рядом: физ. объёмы (50%) + трудоёмкость по направлению (50%) -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Физ. объёмы и оборудование проекта -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Visibility="{Binding HasPhysicalVolumes, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Физ. объёмы проекта"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,0,6" />
                                <dxg:GridControl ItemsSource="{Binding PhysicalVolumes}"
                                                 AutoGenerateColumns="None"
                                                 MaxHeight="240">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="Code" Header="Код" Width="7*" />
                                        <dxg:GridColumn FieldName="Name" Header="Номенклатурная позиция" Width="60*" MinWidth="80" />
                                        <dxg:GridColumn FieldName="UnitName" Header="Ед. изм." Width="7*" />
                                        <dxg:GridColumn FieldName="Quantity" Header="Кол-во" Width="7*">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings DisplayFormat="N2" HorizontalContentAlignment="Right" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Coefficient" Header="Коэфф." Width="7*">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings DisplayFormat="N4" HorizontalContentAlignment="Right" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Total" Header="Итого" Width="12*" MinWidth="60">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings DisplayFormat="N2" HorizontalContentAlignment="Right" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView NavigationStyle="Row"
                                                       AllowEditing="False"
                                                       ShowGroupPanel="False"
                                                       ShowIndicator="False"
                                                       AutoWidth="True" />
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding HasEquipment, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Оборудование проекта"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,0,6" />
                                <dxg:GridControl ItemsSource="{Binding EquipmentVolumes}"
                                                 AutoGenerateColumns="None"
                                                 MaxHeight="240">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="Code" Header="Код" Width="7*" />
                                        <dxg:GridColumn FieldName="Name" Header="Номенклатурная позиция" Width="60*" MinWidth="80" />
                                        <dxg:GridColumn FieldName="UnitName" Header="Ед. изм." Width="7*" />
                                        <dxg:GridColumn FieldName="Quantity" Header="Кол-во" Width="7*">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings DisplayFormat="N2" HorizontalContentAlignment="Right" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Coefficient" Header="Коэфф." Width="7*">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings DisplayFormat="N4" HorizontalContentAlignment="Right" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Total" Header="Итого" Width="12*" MinWidth="60">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings DisplayFormat="N2" HorizontalContentAlignment="Right" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView NavigationStyle="Row"
                                                       AllowEditing="False"
                                                       ShowGroupPanel="False"
                                                       ShowIndicator="False"
                                                       AutoWidth="True" />
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- Трудоёмкость по направлению -->
                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding HasDirectionLabor, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Трудоёмкость по направлению"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                                       Margin="0,0,0,6" />
                            <dxg:GridControl ItemsSource="{Binding DirectionLaborIntensities}"
                                             AutoGenerateColumns="None"
                                             MaxHeight="240">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="DocumentationCode" Header="Шифр документации" Width="75*" MinWidth="80" />
                                    <dxg:GridColumn FieldName="PlannedHours" Header="План, ч" Width="25*">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N2" HorizontalContentAlignment="Right" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView NavigationStyle="Row"
                                                   AllowEditing="False"
                                                   ShowGroupPanel="False"
                                                   ShowIndicator="False"
                                                   AutoWidth="True" />
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" Padding="20,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Анализ версии проекта"
                               FontSize="18" FontWeight="Bold" Foreground="#2C3E50" />
                    <TextBlock Text="{Binding ProjectNameWithVersion, Mode=OneWay}"
                               FontSize="16" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Excel" Command="{Binding ExportToExcelCommand}"
                            Style="{StaticResource ActionButtonStyle}" Background="#27AE60" Margin="0,0,8,0"
                            ToolTip="Экспортировать отчёт в Excel (.xlsx)" />
                    <Button Content="PDF" Command="{Binding ExportToPdfCommand}"
                            Style="{StaticResource ActionButtonStyle}" Background="#E74C3C" Margin="0,0,8,0"
                            ToolTip="Экспортировать отчёт в PDF" />
                    <Button Content="Обновить" Command="{Binding RefreshCommand}"
                            Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="Закрыть" Command="{Binding CloseCommand}"
                            Style="{StaticResource ActionButtonStyle}" Background="#94A3B8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- Loading -->
                <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                        Background="#FFFFFF" CornerRadius="6" Padding="20" Margin="0,0,0,12"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <TextBlock Text="Загрузка отчёта..." FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center" />
                </Border>

                <!-- Error -->
                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                        Background="#FDEDEC" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                        BorderBrush="#E74C3C" BorderThickness="1">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" FontSize="13" TextWrapping="Wrap" />
                </Border>

                <!-- Section: IIC directions -->
                <TextBlock Text="Справочник направлений IIC (полная иерархия)" Style="{StaticResource SectionTitleStyle}" />

                <!-- Заголовок колонок -->
                <Border Background="#2C3E50" CornerRadius="6" Padding="16,8" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Шифр" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Направление" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Факт ФО" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Факт труд., ч" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Факт произв." Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Факт оценка" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="Норм произв." Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="7" Text="Норм оценка" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="8" Text="Норм СО" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="9" Text="Z-оценка" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Итоги: физ. объёмы по единицам измерения -->
                <Border Background="#EBF5FB" CornerRadius="6" Padding="16,10" Margin="0,0,0,4"
                        BorderBrush="#AED6F1" BorderThickness="1"
                        Visibility="{Binding HasPhysicalVolumeTotals, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Факт ФО по группам (ед. изм.)"
                                   Foreground="#1A5276" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Summary.PhysicalVolumeTotalsByUnit}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,2">
                                        <Run Text="{Binding UnitName, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=": " />
                                        <Run Text="{Binding TotalVolume, StringFormat={}{0:N2}, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Итого по проекту -->
                <Border Background="#1E3A5F" CornerRadius="6" Padding="16,8" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ИТОГО" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="По проекту" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0">
                                <Run Text="Перцентиль: " />
                                <Run Text="{Binding Summary.WeightedZScorePercentile, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="—" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Summary.TotalFactLaborHours, StringFormat={}{0:N0}, TargetNullValue=—}"
                                   Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="—" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="—" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="—" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="7" Text="—" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="8" Text="—" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{Binding SummaryInterpretationText, Converter={StaticResource InterpretationToBrush}}" />
                            <TextBlock Text="{Binding Summary.WeightedZScore, StringFormat={}{0:N2}, TargetNullValue=—}"
                                       Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="#34495E" CornerRadius="6" Padding="16,8" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="" />
                        <TextBlock Grid.Column="1" Text="{Binding SummaryInterpretationText, Mode=OneWay}"
                                   Foreground="#ECF0F1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Нераспределённая трудоёмкость -->
                <Border Background="#FFF8E1" CornerRadius="6" Padding="16,8" Margin="0,0,0,8"
                        BorderBrush="#FFE082" BorderThickness="1"
                        Visibility="{Binding HasUnallocatedLabor, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="—" Foreground="#F57F17" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Нераспределённая трудоёмкость"
                                   Foreground="#E65100" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="—" Foreground="#795548" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Summary.UnallocatedLaborHours, StringFormat={}{0:N0}, TargetNullValue=—}"
                                   Foreground="#E65100" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Directions}"
                              ItemTemplate="{StaticResource DirectionCardTemplate}" />

                <!-- Виды работ: общий список трудоёмкости проекта -->
                <TextBlock Text="Виды работ (трудоёмкость проекта)" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,12" />
                <Border Style="{StaticResource CardStyle}">
                    <dxg:GridControl ItemsSource="{Binding LaborIntensities}"
                                     AutoGenerateColumns="None"
                                     MaxHeight="320">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="DocumentationCode" Header="Шифр документации" Width="2*" MinWidth="120" />
                            <dxg:GridColumn FieldName="Brand" Header="Марка" Width="*" MinWidth="80" />
                            <dxg:GridColumn FieldName="WorkDirectionName" Header="Направление" Width="2*" MinWidth="120" />
                            <dxg:GridColumn FieldName="PlannedHours" Header="План, ч" Width="100">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="N2" HorizontalContentAlignment="Right" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="ActualHours" Header="Факт, ч" Width="100">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="N2" HorizontalContentAlignment="Right" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem FieldName="DocumentationCode" SummaryType="Count" DisplayFormat="Строк: {0}" />
                            <dxg:GridSummaryItem FieldName="PlannedHours" SummaryType="Sum" DisplayFormat="N2" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowEditing="False" NavigationStyle="Row"
                                           ShowGroupPanel="False" ShowIndicator="False"
                                           ShowTotalSummary="True" AutoWidth="True" />
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
