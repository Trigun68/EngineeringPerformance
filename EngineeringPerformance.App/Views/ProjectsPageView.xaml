                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding OpenVersionAnalysisCommand}"
                                            IsEnabled="{Binding FactVersionId, Converter={StaticResource NullToBool}}"
                                            Background="#3498DB" Foreground="Black" BorderThickness="0"
                                            Padding="12,8" Margin="0,0,8,0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📊" Margin="0,0,6,0" />
                                            <TextBlock Text="Анализ версии (экран)" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ExportFactAnalysisToExcelCommand}"
                                            IsEnabled="{Binding FactVersionId, Converter={StaticResource NullToBool}}"
                                            Background="#27AE60" Foreground="Black" BorderThickness="0"
                                            Padding="12,8" Margin="0,0,8,0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Assets/icons8-microsoft-excel-2019-48.png" Width="16" Height="16" Margin="0,0,6,0" />
                                            <TextBlock Text="Экспорт в Excel" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ExportFactAnalysisToPdfCommand}"
                                            IsEnabled="{Binding FactVersionId, Converter={StaticResource NullToBool}}"
                                            Background="#E74C3C" Foreground="Black" BorderThickness="0"
                                            Padding="12,8" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄" Margin="0,0,6,0" />
                                            <TextBlock Text="Экспорт в PDF" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Группа: Прогноз -->
                        <Border Background="#EAFAF1" BorderBrush="#A9DFBF" BorderThickness="1"
                                CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Прогноз трудозатрат" FontWeight="SemiBold" FontSize="14"
                                           Foreground="#1E8449" Margin="0,0,0,8" />
                                <TextBlock Foreground="#5D6D7E" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12">
                                    Три сценария трудозатрат (базовый, оптимистичный, пессимистичный) по плановым объёмам.
                                    Требуется выбранная плановая версия на вкладке «Прогнозирование».
                                </TextBlock>
                                <Button Command="{Binding ExportForecastToExcelCommand}"
                                        IsEnabled="{Binding PlanVersionId, Converter={StaticResource NullToBool}}"
                                        Background="#27AE60" Foreground="Black" BorderThickness="0"
                                        Padding="12,8" HorizontalAlignment="Left" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/icons8-microsoft-excel-2019-48.png" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Экспорт прогноза в Excel" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Группа: Сравнение версий -->
                        <Border Background="#FEF9E7" BorderBrush="#F9E79F" BorderThickness="1"
                                CornerRadius="4" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Сравнение версий" FontWeight="SemiBold" FontSize="14"
                                           Foreground="#7D6608" Margin="0,0,0,8" />
                                <TextBlock Foreground="#5D6D7E" FontSize="12" TextWrapping="Wrap">
                                    Для сравнения двух версий перейдите на вкладку «Сравнение версий»,
                                    выберите Версию А и Версию Б. Таблица с Δ Z-score отобразится там же.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</UserControl>
