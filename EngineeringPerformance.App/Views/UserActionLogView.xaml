<UserControl x:Class="EngineeringPerformance.App.Views.UserActionLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Панель фильтров -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="С:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <dxe:DateEdit Grid.Column="1" Width="120" EditValue="{Binding FromDate, Mode=TwoWay}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="2" Text="По:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <dxe:DateEdit Grid.Column="3" Width="120" EditValue="{Binding ToDate, Mode=TwoWay}" Margin="0,0,8,0" />

            <TextBlock Grid.Column="4" Text="Пользователь:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <dxe:ComboBoxEdit Grid.Column="5" Width="200" Margin="0,0,8,0"
                              ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                              DisplayMember="DisplayName"
                              IsTextEditable="False" />

            <TextBlock Grid.Column="6" Text="Действие:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <dxe:ComboBoxEdit Grid.Column="7" Width="200"
                              ItemsSource="{Binding ActionTypes}"
                              SelectedItem="{Binding SelectedActionType, Mode=TwoWay}"
                              IsTextEditable="False" />
        </Grid>

        <!-- Тулбар: обновить + экспорт + импорт -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8"
                    IsEnabled="{Binding IsNotBusy}">
            <Button Command="{Binding RefreshAsyncCommand}" Margin="0,0,4,0" Padding="8,4"
                    ToolTip="Обновить">
                <TextBlock Text="Обновить" />
            </Button>
            <Button Command="{Binding ExportAndPurgeAsyncCommand}" Margin="0,0,4,0" Padding="8,4"
                    ToolTip="Сохранить весь журнал в CSV и удалить из БД">
                <TextBlock Text="Сохранить в файл и удалить" />
            </Button>
            <Button Command="{Binding ImportAsyncCommand}" Margin="0,0,4,0" Padding="8,4"
                    ToolTip="Восстановить записи журнала из CSV-файла">
                <TextBlock Text="Восстановить из файла" />
            </Button>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="#666" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Сетка журнала -->
        <dxg:GridControl x:Name="Grid" Grid.Row="2"
                         ItemsSource="{Binding Rows}"
                         AutoGenerateColumns="None"
                         SelectionMode="Row">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="Timestamp" Header="Время (UTC)" Width="160" ReadOnly="True">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings DisplayFormat="yyyy-MM-dd HH:mm:ss" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="UserName" Header="Пользователь" Width="140" ReadOnly="True" />
                <dxg:GridColumn FieldName="ActionType" Header="Действие" Width="140" ReadOnly="True" />
                <dxg:GridColumn FieldName="EntityType" Header="Сущность" Width="160" ReadOnly="True" />
                <dxg:GridColumn FieldName="EntityId" Header="ID" Width="80" ReadOnly="True" />
                <dxg:GridColumn FieldName="Description" Header="Описание" Width="*" ReadOnly="True" />
                <dxg:GridColumn FieldName="IpOrHost" Header="Хост" Width="120" ReadOnly="True" />
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView AllowEditing="False"
                               ShowGroupPanel="True"
                               NavigationStyle="Row" />
            </dxg:GridControl.View>
        </dxg:GridControl>

        <!-- Сообщение об ошибке -->
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="Red"
                   Margin="0,8,0,0" TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
    </Grid>
</UserControl>
