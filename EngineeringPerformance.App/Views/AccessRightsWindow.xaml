<UserControl x:Class="EngineeringPerformance.App.Views.AccessRightsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Command="{Binding RefreshAsyncCommand}" Margin="0,0,4,0" ToolTip="Обновить">
                <Image Source="/Assets/icons8-update-100.png" Width="20" Height="20" />
            </Button>
            <Button Click="SaveButton_Click" Margin="0,0,4,0" ToolTip="Сохранить все">
                <Image Source="/Assets/icons8-save-96.png" Width="20" Height="20" />
            </Button>
            <TextBlock Text="Управление правами доступа для ролей"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="#666666" />
        </StackPanel>

        <dxg:GridControl x:Name="Grid" Grid.Row="1"
                         ItemsSource="{Binding Rows}"
                         AutoGenerateColumns="None"
                         CustomUnboundColumnData="Grid_CustomUnboundColumnData">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="ObjectNameDisplay" Header="Объект" Width="240" ReadOnly="True">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RowData.Row.ObjectNameDisplay}"
                                       FontWeight="{Binding RowData.Row.IsHeader, Converter={StaticResource BoolToFontWeightConverter}}"
                                       Margin="{Binding RowData.Row.Indent, Converter={StaticResource IndentToMarginConverter}}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView AllowEditing="True" NavigationStyle="Cell"
                               ShowTotalSummary="False"
                               ShowGroupPanel="False"
                               AllowCellMerge="False" />
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
