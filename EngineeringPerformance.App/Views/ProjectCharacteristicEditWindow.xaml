<Window x:Class="EngineeringPerformance.App.Views.ProjectCharacteristicEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="{Binding WindowTitle}"
        Height="500" Width="720"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="{Binding WindowTitle}" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование" VerticalAlignment="Center" Margin="0,0,8,8" />
                <dxe:TextEdit Grid.Row="0" Grid.Column="1" EditValue="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,4">
                    <TextBlock Text="Варианты" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Добавить" Command="{Binding AddOptionCommand}" Width="100" Margin="0,0,8,0" />
                    <Button Content="Удалить" Command="{Binding DeleteOptionCommand}" Width="100" />
                </StackPanel>

                <dxg:GridControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                 ItemsSource="{Binding Options}"
                                 SelectedItem="{Binding SelectedOption}"
                                 AutoGenerateColumns="None"
                                 Margin="0,0,0,8">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Name" Header="Описание варианта" Width="*">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ValuePercent" Header="PD, %" Width="100">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings DisplayFormat="N2" MinValue="0" MaxValue="100" Increment="0.1" IsFloatValue="True" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ComparisonAccuracy" Header="Точность сравнения" Width="180" ReadOnly="True" AllowEditing="False" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowEditing="True"
                                       NavigationStyle="Cell"
                                       ShowGroupPanel="False"
                                       AutoWidth="False"
                                       NewItemRowPosition="None" />
                    </dxg:GridControl.View>
                </dxg:GridControl>

                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Margin="0,0,8,0" IsDefault="True" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
