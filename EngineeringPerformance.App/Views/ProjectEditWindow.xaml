<Window x:Class="EngineeringPerformance.App.Views.ProjectEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="{Binding WindowTitle}"
        Height="800" Width="1200"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <TextBlock Text="{Binding WindowTitle}" Foreground="#ECF0F1" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="350" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" MinHeight="250" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                <!-- Top Section: Three Columns -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="360" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Project Data -->
                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#2C3E50" Padding="10,8">
                                <TextBlock Text="Основные данные проекта" Foreground="#ECF0F1" FontWeight="SemiBold" FontSize="13" />
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Код" VerticalAlignment="Center" />
                                    <dxe:TextEdit Grid.Row="0" Grid.Column="1"
                                                  EditValue="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ValidateOnTextInput="True" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Название" VerticalAlignment="Center" />
                                    <dxe:TextEdit Grid.Row="2" Grid.Column="1"
                                                  EditValue="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ValidateOnTextInput="True" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Номер работы" VerticalAlignment="Center" />
                                    <dxe:TextEdit Grid.Row="4" Grid.Column="1"
                                                  EditValue="{Binding WorkNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ValidateOnTextInput="True" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="ГИП" VerticalAlignment="Center" />
                                    <dxe:TextEdit Grid.Row="6" Grid.Column="1"
                                                  EditValue="{Binding Gip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ValidateOnTextInput="True" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Начало работы" VerticalAlignment="Center" />
                                    <dxe:DateEdit Grid.Row="8" Grid.Column="1"
                                                  EditValue="{Binding WorkStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayFormatString="dd.MM.yyyy"
                                                  MaskUseAsDisplayFormat="True" />

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Статус работы" VerticalAlignment="Center" />
                                    <dxe:ComboBoxEdit Grid.Row="10" Grid.Column="1"
                                                      EditValue="{Binding WorkStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding WorkStatusItems}"
                                                      IsTextEditable="False" />
                                </Grid>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Margin="10,8" Orientation="Vertical">
                                <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Отклонение по проекту:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding ProjectDeviationPercent, StringFormat={}{0:N2} %, TargetNullValue='—'}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <UniformGrid Rows="1" Columns="2">
                                    <Button Margin="0,0,4,0" Padding="10,6"
                                            HorizontalAlignment="Stretch"
                                            Content="Дополнительно"
                                            Command="{Binding OpenAdditionalFieldsCommand}" />
                                    <Button Margin="4,0,0,0" Padding="10,6"
                                            HorizontalAlignment="Stretch"
                                            Content="Характеристики"
                                            Command="{Binding OpenCharacteristicsCommand}" />
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Center Column: Analysis Versions -->
                    <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#2C3E50" Padding="10,8">
                                <TextBlock Text="Версии анализа" Foreground="#ECF0F1" FontWeight="SemiBold" FontSize="13" />
                            </Border>

                            <dxg:GridControl Grid.Row="1" ItemsSource="{Binding AnalysisVersions}"
                                             SelectedItem="{Binding SelectedVersion}"
                                             AutoGenerateColumns="None"
                                             Margin="6"
                                             MouseDoubleClick="AnalysisVersionsGrid_MouseDoubleClick">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="VersionName" Header="Имя" Width="*" />
                                    <dxg:GridColumn FieldName="Description" Header="Описание" Width="2*" />
                                    <dxg:GridColumn FieldName="CreatedAt" Header="Дата создания" Width="*">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="dd.MM.yyyy HH:mm" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="DirectionName" Header="Направление анализа" Width="*" />
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AllowEditing="False"
                                                   NavigationStyle="Row"
                                                   ShowGroupPanel="False"
                                                   AutoWidth="False" />
                                </dxg:GridControl.View>
                            </dxg:GridControl>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="6,8">
                                <Button Command="{Binding AddVersionCommand}" Margin="0,0,4,0" Width="32" Height="32" Padding="0" ToolTip="Добавить версию">
                                    <Viewbox Stretch="Uniform">
                                        <Image Source="/Assets/icons8-add-96.png" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding EditVersionCommand}" Margin="0,0,4,0" Width="32" Height="32" Padding="0" ToolTip="Изменить версию">
                                    <Viewbox Stretch="Uniform">
                                        <Image Source="/Assets/icons8-edit-90.png" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding DeleteVersionCommand}" Width="32" Height="32" Padding="0" ToolTip="Удалить версию">
                                    <Viewbox Stretch="Uniform">
                                        <Image Source="/Assets/icons8-delete-96.png" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Column: Project Participants -->
                    <Border Grid.Column="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#2C3E50" Padding="10,8">
                                <TextBlock Text="Участники проекта" Foreground="#ECF0F1" FontWeight="SemiBold" FontSize="13" />
                            </Border>

                            <dxg:GridControl Grid.Row="1" ItemsSource="{Binding ProjectParticipants}"
                                             SelectedItem="{Binding SelectedProjectParticipant}"
                                             AutoGenerateColumns="None"
                                             Margin="6"
                                             MouseDoubleClick="ProjectParticipantsGrid_MouseDoubleClick">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="UserName" Header="Имя" Width="*" />
                                    <dxg:GridColumn FieldName="Role" Header="Роль" Width="80" />
                                    <dxg:GridColumn FieldName="AccessLevelDisplay" Header="Доступ" Width="100" />
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AllowEditing="False" NavigationStyle="Row" ShowGroupPanel="False" />
                                </dxg:GridControl.View>
                            </dxg:GridControl>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="6,8">
                                <Button Command="{Binding AddParticipantCommand}" Margin="0,0,4,0" Width="32" Height="32" Padding="0" ToolTip="Добавить участника">
                                    <Viewbox Stretch="Uniform">
                                        <Image Source="/Assets/icons8-add-96.png" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding EditParticipantCommand}" Margin="0,0,4,0" Width="32" Height="32" Padding="0" ToolTip="Изменить участника">
                                    <Viewbox Stretch="Uniform">
                                        <Image Source="/Assets/icons8-edit-90.png" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding DeleteParticipantCommand}" Width="32" Height="32" Padding="0" ToolTip="Удалить участника">
                                    <Viewbox Stretch="Uniform">
                                        <Image Source="/Assets/icons8-delete-96.png" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom Section: Performance -->
                <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#2C3E50" Padding="10,8">
                            <TextBlock Text="Производительность" Foreground="#ECF0F1" FontWeight="SemiBold" FontSize="13" />
                        </Border>

                        <Grid Grid.Row="1" Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Performance Data Grid -->
                            <dxg:GridControl Grid.Column="0" ItemsSource="{Binding PerformanceData}"
                                             SelectedItem="{Binding SelectedPerformanceItem}"
                                             AutoGenerateColumns="None">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="Name" Header="Наименование" Width="200" />
                                    <dxg:GridColumn FieldName="NormUnitName" Header="Ед. изм. (норма ИИС)" Width="110" />
                                    <dxg:GridColumn FieldName="FactPhysicalVolume" Header="Факт ФО" Width="90">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N2" HorizontalContentAlignment="Right" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="FactLaborHours" Header="Факт Трудоемк" Width="100">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N2" HorizontalContentAlignment="Right" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="FactProductivity" Header="Факт производит." Width="110">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N4" HorizontalContentAlignment="Right" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="FactEstimate" Header="Факт оценка" Width="90">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N4" HorizontalContentAlignment="Right" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="NormProductivity" Header="Норм производит." Width="110">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N4" HorizontalContentAlignment="Right" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="NormEstimate" Header="Норм оценка" Width="90">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N4" HorizontalContentAlignment="Right" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="NormStdDev" Header="Норм станд. откл." Width="110">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N4" HorizontalContentAlignment="Right" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="ZScore" Header="Z-score" Width="80">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="N4" HorizontalContentAlignment="Right" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Interpretation" Header="Интерпретация" Width="200">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RowData.Row.Interpretation}" Value="Отличная производительность">
                                                                    <Setter Property="Background" Value="#4CAF50" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RowData.Row.Interpretation}" Value="Хорошая производительность">
                                                                    <Setter Property="Background" Value="#8BC34A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RowData.Row.Interpretation}" Value="Удовлетворительная производительность">
                                                                    <Setter Property="Background" Value="#FFC107" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RowData.Row.Interpretation}" Value="Требует внимания">
                                                                    <Setter Property="Background" Value="#FF9800" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RowData.Row.Interpretation}" Value="Критически низкая производительность">
                                                                    <Setter Property="Background" Value="#F44336" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding RowData.Row.Interpretation}" Foreground="White" FontWeight="SemiBold" FontSize="11" TextAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="PerformanceTreeListView"
                                                      AllowEditing="False"
                                                      AllowSorting="False"
                                                      NavigationStyle="Row"
                                                      KeyFieldName="Id"
                                                      ParentFieldName="ParentId"
                                                      AutoWidth="True"
                                                      ShowIndicator="False"
                                                      ShowVerticalLines="False" />
                                </dxg:GridControl.View>
                            </dxg:GridControl>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="8,0,0,0" VerticalAlignment="Top">
                                <Button Command="{Binding ImportPhysicalVolumesCommand}" Margin="0,0,0,6" Width="160" Height="36" ToolTip="Импорт физических объёмов из Excel">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/icons8-microsoft-excel-2019-48.png" Width="18" Height="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Импорт физ. объёмов" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeletePhysicalVolumesCommand}" Margin="0,0,0,6" Width="160" Height="36" ToolTip="Удалить физические объёмы">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/icons8-delete-96.png" Width="18" Height="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Удалить физ. объёмы" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ImportLaborIntensitiesCommand}" Margin="0,0,0,6" Width="160" Height="36" ToolTip="Импорт трудоёмкости из Excel">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/icons8-microsoft-excel-2019-48.png" Width="18" Height="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Импорт трудоёмкости" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteLaborIntensitiesCommand}" Width="160" Height="36" ToolTip="Удалить трудоёмкость">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/icons8-delete-96.png" Width="18" Height="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Удалить трудоёмкость" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Кнопка отчёта «Анализ версии проекта» — ниже блока производительности -->
                <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="0" Margin="0,12,0,0">
                    <Button Command="{Binding OpenVersionAnalysisCommand}"
                            HorizontalAlignment="Left"
                            Padding="14,8"
                            Background="#3498DB"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Анализ версии проекта" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Error Message -->
                <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>
    </Grid>
</Window>
