<Application x:Class="EngineeringPerformance.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EngineeringPerformance.App"
             xmlns:conv="clr-namespace:EngineeringPerformance.App.Converters"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             Startup="Application_Startup"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <conv:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
        <conv:BoolToFontStyleConverter x:Key="BoolToFontStyle" />
        <conv:BoolToTotalBackgroundConverter x:Key="BoolToTotalBackground" />
        <conv:IndentToMarginConverter x:Key="IndentToMarginConverter" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:NullToBoolConverter x:Key="NullToBool" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:AnalysisDirectionToStringConverter x:Key="AnalysisDirectionToString" />

        <!-- Унифицированный стиль lookup-комбобокса справочников: ввод текста + инкрементная фильтрация по подстроке.
             Применяется ко всем lookup-полям карточек/диалогов, где список — справочник из БД.
             Документация: docs/features/directory-search-and-lookup-filtering.md -->
        <Style x:Key="LookupComboBoxEdit" TargetType="dxe:ComboBoxEdit">
            <Setter Property="IncrementalFiltering" Value="True" />
            <Setter Property="FilterCondition" Value="Contains" />
            <Setter Property="AutoComplete" Value="True" />
            <Setter Property="ImmediatePopup" Value="True" />
            <Setter Property="ValidateOnTextInput" Value="False" />
        </Style>

        <!-- Стиль строки итога в таблице прогноза -->
        <Style x:Key="ForecastRowStyle" TargetType="dxg:RowControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Row.IsTotal}" Value="True">
                    <Setter Property="Background" Value="#EBF5FB" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль строки итога в таблице по объектам -->
        <Style x:Key="FacilityForecastRowStyle" TargetType="dxg:RowControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Row.IsTotal}" Value="True">
                    <Setter Property="Background" Value="#1E3A5F" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль вкладки: плоская кнопка, активная — синяя, иконка + текст -->
        <Style x:Key="PageTabItemStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#F0F2F5"
                                BorderThickness="0"
                                Padding="20,10"
                                MinWidth="120"
                                Cursor="Hand">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock x:Name="IconText"
                                           Text="{Binding Icon, RelativeSource={RelativeSource AncestorType=TabItem, AncestorLevel=1}, FallbackValue=''}"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"
                                           Foreground="#7F8C8D" />
                                <ContentPresenter x:Name="HeaderContent"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="Foreground" Value="#7F8C8D" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#3498DB" />
                                <Setter TargetName="IconText" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="HeaderContent" Property="TextBlock.Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#D5E8F5" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#2980B9" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль TabControl: без рамки, вкладки слева направо в одну строку -->
        <Style x:Key="PageTabControlStyle" TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PageTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Строка вкладок -->
                            <Border Grid.Row="0"
                                    Background="#F0F2F5"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent" />
                            </Border>

                            <!-- Содержимое активной вкладки -->
                            <Border Grid.Row="1"
                                    Background="#FFFFFF"
                                    BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
