{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "EngineeringPerformance",
    "Audience": "EngineeringPerformance",
    "ExpirationMinutes": 1440,
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "AccessTokenCookieName": "ep_auth_token",
    "RefreshTokenCookieName": "ep_refresh_token",
    "ClockSkewSeconds": 30
  },
  "Mfa": {
    "Enabled": true,
    "Issuer": "EngineeringPerformance",
    "RequiredRoles": [ "SuperAdmin", "Admin" ],
    "OptionalForOthers": true,
    "SecretEncryptionPurpose": "EngineeringPerformance.MfaSecret.v1",
    "TotpWindowSeconds": 30,
    "TotpTolerance": 1
  },
  "RateLimit": {
    "Enabled": true,
    "LoginMaxAttempts": 5,
    "LoginWindowMinutes": 15,
    "RefreshMaxPerMinute": 10,
    "NegotiateMaxPerMinute": 20,
    "LockoutDurationMinutes": 15
  },
  "AuthAudit": {
    "Enabled": true,
    "RetentionDays": 365
  },
  "Ldap": {
    "Enabled": false,
    "Server": "",
    "Port": 389,
    "UseSsl": false,
    "Domain": "",
    "BaseDn": "",
    "BindUsername": "",
    "BindPassword": "",
    "GroupSearchBaseDn": ""
  },
  "Admin": {
    "SeedDefaultAdmin": true,
    "DefaultAdminUsername": "admin",
    "DefaultAdminPassword": ""
  },
  "Spnego": {
    "Enabled": false,
    "TrustedProxySecret": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Monitoring": {
    "SampleIntervalSeconds": 10,
    "RetentionMinutes": 60,
    "ActiveUserWindowMinutes": 5,
    "SqlMemoryLimitMib": 2048,
    "HistoryRetentionDays": 90
  },
  "SqlProfiling": {
    "Enabled": false,
    "MinDurationMsToPersist": 50,
    "PersistCommandTimeoutSeconds": 8,
    "RetentionDays": 14,
    "MaxParametersLength": 4000,
    "MaxSqlPreviewLength": 2000
  },
  "Analytics": {
    "Trends": {
      "WeightMode": "basisHours",
      "GapThresholdDays": 90,
      "LightenStep": 0.18,
      "ZClipMax": 5.0,
      "MinSigma": 0.000001,
      "AggregateSameDay": true,
      "CacheTtlMinutes": 5
    },
    "FactNormAnalysis": {
      "DeltaR2Threshold": 0.05,
      "MinAcceptableR2": 0.70,
      "ParamDriftThreshold": 0.15,
      "DeltaAicSignificant": 2.0,
      "DeltaBicStrong": 6.0,
      "ThresholdMeanPct": 0.10,
      "ThresholdSigmaPct": 0.20,
      "MinPointsForFit": 5,
      "MinPointsForReliableFit": 10,
      "PValueThreshold": 0.05,
      "MaxPointsPerRequest": 100000,
      "MaxPeriodDays": 1825,
      "RemoveOutliers3Sigma": true
    },
    "Accuracy": {
      "LowMaxDays": 180,
      "MediumMaxDays": 365,
      "LowMinPoints": 30,
      "HighMinPoints": 50
    },
    "NormCreation": {
      "DefaultStatus": "Draft",
      "AllowBackdatedEffectiveFrom": false,
      "RequireConfirmOnSave": true
    },
    "NormHealth": {
      "Enabled": true,
      "CacheTtlMinutes": 5,
      "OverlapConflict": { "Enabled": true, "Severity": "Error" },
      "CoverageGap": { "Enabled": true, "Severity": "Warning" },
      "NoActiveNorm": { "Enabled": true, "Severity": "Error" },
      "StaleActive": { "Enabled": true, "Severity": "Warning" },
      "DuplicateNorm": { "Enabled": true, "Severity": "Warning", "DupParamTolerance": 0.05 },
      "ZeroSigma": { "Enabled": true, "Severity": "Error", "MinValidSigma": 0.000001 },
      "InvalidParams": { "Enabled": true, "Severity": "Error" },
      "UnusedNorm": { "Enabled": true, "Severity": "Info", "UnusedWindowDays": 180 },
      "StaleFuture": { "Enabled": true, "Severity": "Info", "DraftMaxAgeDays": 90 },
      "BrokenChain": { "Enabled": true, "Severity": "Warning", "ChainToleranceDays": 1 }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
