# SQL Server
SQL_SA_PASSWORD=Your_strong_SA_password1!

# JWT (API) — минимум 32 символа
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=EngineeringPerformance
JWT_AUDIENCE=EngineeringPerformance
JWT_EXPIRATION_MINUTES=60

# SPNEGO (production): Nginx/IIS auth_gss передаёт X-Remote-User + X-Trusted-Proxy-Token
SPNEGO_ENABLED=false
PROXY_TRUSTED_SECRET=

# Windows auto-login на dev-стенде (Linux Docker не видит WindowsIdentity)
# Development + учётка из поля Windows в карточке пользователя
ASPNETCORE_ENVIRONMENT=Production
DEV_WINDOWS_USER=

# Web
WEB_PORT=80

# API host filtering (через запятую/точку с запятой — домены туннеля и локальные)
ALLOWED_HOSTS=localhost;127.0.0.1;eng-perf.tech-lab24.ru

# CORS (prod): origin фронтенда, если API вызывается с другого хоста
CORS_ORIGIN_0=https://eng-perf.tech-lab24.ru
CORS_ORIGIN_1=http://127.0.0.1:8081

# Optional: client dev (Vite)
# VITE_API_BASE_URL=/api
