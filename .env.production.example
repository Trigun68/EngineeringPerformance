# Production — скопировать в .env на сервере (не коммитить секреты)

SQL_SA_PASSWORD=
JWT_SECRET=
JWT_ISSUER=EngineeringPerformance
JWT_AUDIENCE=EngineeringPerformance
JWT_EXPIRATION_MINUTES=60

SPNEGO_ENABLED=true
# Тот же секрет, что frontend PROXY_TRUSTED_SECRET и backend Spnego__TrustedProxySecret
PROXY_TRUSTED_SECRET=

WEB_PORT=443

# API (docker-compose override или env file для api service):
# Cors__AllowedOrigins__0=https://ep.company.local
# ASPNETCORE_ENVIRONMENT=Production
