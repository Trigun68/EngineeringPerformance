<?xml version="1.0" encoding="utf-8"?>
<!--
  Проектный NuGet.Config: на этой машине в глобальной конфигурации прописана
  fallback-папка "C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages",
  которой не существует. Такая ситуация ломает `ResolvePackageAssets`, поэтому мы
  явно очищаем fallback-папки и оставляем только nuget.org как источник.
-->
<configuration>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
